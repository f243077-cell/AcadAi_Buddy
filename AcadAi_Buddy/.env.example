# Copy to .env (git-ignored) and fill in. .env is bundled into the app as an
# asset, so anything here can be extracted from an APK: use a key with a
# spend limit, or point AI_BASE_URL at a proxy that holds the key server-side.

OPENROUTER_API_KEY=

# Optional overrides (defaults shown).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemma-4-31b-it:free
AI_VISION_MODEL=google/gemma-4-31b-it:free
